#include "common.h"
#include "server.c"

int create_listen_socket(int optimal_backlog) {
    int fd = socket(AF_INET, SOCK_STREAM, 0);
    
    if(fd < 0){
        ErrorManagementWithClosedSocket("Cannot create socket fd. Exiting...");
    }

    int opt = 1;
    if(setsockopt(fd, SOL_SOCKET, SO_REUSEADDR,
        &opt, sizeof(opt)) < 0) {
            ErrorManagementWithOpenedSocket("Cannot set opt property. Exiting..."
                , fd);
    }

    struct sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = htonl(INADDR_ANY);
    addr.sin_port = PORT;

    if(bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
        ErrorManagementWithOpenedSocket("Cannot set opt property. Exiting...", fd);
    }

    if (listen(fd, optimal_backlog) < 0) {
        ErrorManagementWithOpenedSocket("Cannot set socket in listening mode. Exiting...", fd);
    }

    return fd;
}